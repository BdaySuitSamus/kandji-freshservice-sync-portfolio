<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.kandji-freshservice-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/YOU/Projects/kandji-freshservice-sync/run.sh</string>
  </array>
  <!-- Fires every Monday 8:00; run.sh only syncs if the last success was 13+ days ago. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>1</integer>
    <key>Hour</key><integer>8</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/YOU/Projects/kandji-freshservice-sync/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOU/Projects/kandji-freshservice-sync/launchd.log</string>
</dict>
</plist>
